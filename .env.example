# Environment Configuration for UrbanTransit IQ
# Copy this to .env and fill in your values

# ============================================
# EXECUTION MODE
# ============================================
# DEVELOPMENT = local filesystem, no HDFS required
# COMPETITION = genuine HDFS, Spark, Spark MLlib required
EXECUTION_MODE=DEVELOPMENT

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET_KEY=urbantransit-iq-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# APACHE SPARK
# ============================================
SPARK_MASTER=local[*]
SPARK_APP_NAME=UrbanTransitIQ
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ============================================
# HADOOP / HDFS
# ============================================
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_BASE_PATH=/urbantransit

# ============================================
# DATA PATHS
# ============================================
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports

# ============================================
# API SERVER
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO




# Environment Configuration for UrbanTransit IQ
# Copy this to .env and fill in your values

# ============================================
# EXECUTION MODE
# ============================================
# DEVELOPMENT = local filesystem, no HDFS required
# COMPETITION = genuine HDFS, Spark, Spark MLlib required
EXECUTION_MODE=DEVELOPMENT

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# POSTGRESQL (Docker)
# ============================================
POSTGRES_USER=urbantransit
POSTGRES_PASSWORD=UrbanTransit2026!
POSTGRES_DB=urbantransit_iq
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://urbantransit:UrbanTransit2026!@localhost:5433/urbantransit_iq

# ============================================
# PGADMIN (Web Dashboard)
# ============================================
PGADMIN_EMAIL=admin@urbantransit.iq
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
PGADMIN_URL=http://localhost:5050

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET_KEY=urbantransit-iq-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=affan@urbantransit.iq
ADMIN_PASSWORD=UrbanTransit2026!
ADMIN_FULL_NAME=Muhammad Affan

# ============================================
# APACHE SPARK
# ============================================
SPARK_MASTER=local[*]
SPARK_APP_NAME=UrbanTransitIQ
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ============================================
# HADOOP / HDFS
# ============================================
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_BASE_PATH=/urbantransit

# ============================================
# DATA PATHS
# ============================================
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports

# ============================================
# API SERVER
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO



